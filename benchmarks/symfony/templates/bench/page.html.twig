{% extends 'bench/layout.html.twig' %}

{% block title %}Symfony — Benchmark page{% endblock %}

{% block content %}
    <section>
        <h1>Build something great, faster</h1>
        <div class="rank-list">
            {% for item in items %}
                <div class="rank-row">
                    <div class="rank-number">#{{ item.rank }}</div>
                    <div class="rank-body"><h3>{{ item.title }}</h3><p>{{ item.description }}</p></div>
                    <div class="rank-meta">{{ item.meta }}</div>
                </div>
            {% endfor %}
        </div>
        <form method="post" action="/contact">
            <input type="hidden" name="_token" value="{{ csrf_token('bench') }}">
            <button type="submit">Send</button>
        </form>
    </section>
{% endblock %}

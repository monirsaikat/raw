APP_NAME=ComfreePHP
APP_ENV=local
APP_DEBUG=true
APP_URL=
APP_TIMEZONE=UTC
# Generate with: php console.php key:generate
APP_KEY=
LOG_LEVEL=debug

SESSION_NAME=comfreephp_session
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
HSTS_ENABLED=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Queue
# sync runs jobs inline; database stores them in the `jobs` table for queue:work
#QUEUE_CONNECTION=sync
#QUEUE_NAME=default
#QUEUE_DB_CONNECTION=
#QUEUE_RETRY_AFTER=90

# Session storage: file (default) | database (run session:table + migrate) | cookie (4 KB limit) | array
SESSION_DRIVER=file
SESSION_TABLE=sessions
SESSION_LAZY_WRITE=true

# Mail
# log writes messages to storage/logs; smtp/sendmail deliver; array is for tests
#MAIL_MAILER=log
#MAIL_HOST=smtp.example.com
#MAIL_PORT=587
#MAIL_ENCRYPTION=tls
#MAIL_USERNAME=
#MAIL_PASSWORD=
#MAIL_TIMEOUT=30
#MAIL_EHLO_DOMAIN=
#MAIL_FROM_ADDRESS=hello@example.com
#MAIL_FROM_NAME="${APP_NAME}"

<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>404 - Page Not Found</title>
    <style>
        body { font-family: system-ui, sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; background: #f8f9fa; color: #212529; }
        .box { text-align: center; }
        h1 { font-size: 3rem; margin-bottom: 0.5rem; }
        a { color: #0d6efd; }
    </style>
</head>

<body>
    <div class="box">
        <h1>404</h1>
        <p>The page you're looking for doesn't exist.</p>
        <a href="{navigate name='home'}">Go home</a>
    </div>
</body>

</html>
